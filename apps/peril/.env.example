# Copy to .env.production.local (or .env.production) with your Firebase web app config.
# These values identify your project and are not secrets; security comes from firebase/database.rules.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
