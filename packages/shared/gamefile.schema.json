{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "rounds": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "categories": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "hint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "clues": {
                  "minItems": 5,
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 100000
                      },
                      "clue": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "response": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "doubleDown": {
                        "type": "boolean"
                      }
                    },
                    "required": ["value", "clue", "response"]
                  }
                }
              },
              "required": ["name", "clues"]
            }
          }
        },
        "required": ["categories"]
      }
    },
    "final": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "clue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "response": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": ["category", "clue", "response"]
    }
  },
  "required": ["version", "title", "rounds"]
}
